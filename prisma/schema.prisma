datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  ENGINEER
  VIEWER
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
  MAINTENANCE
}

enum DeploymentStatus {
  SUCCESSFUL
  BUILDING
  FAILED
  ROLLED_BACK
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentEventType {
  DETECTED
  ACKNOWLEDGED
  INVESTIGATION_STARTED
  ROOT_CAUSE_IDENTIFIED
  MITIGATION_APPLIED
  RESOLVED
  NOTE_ADDED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  Membership[]
  incidents    Incident[]    @relation("AssignedIncidents")
  notifications Notification[]

  @@index([email])
}

model Workspace {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  services     Service[]
  environments Environment[]
  deployments  Deployment[]
  incidents    Incident[]
  logEntries   LogEntry[]
  metricPoints MetricPoint[]
  aiAnalyses   AIAnalysis[]
  notifications Notification[]
}

model Membership {
  id          String    @id @default(uuid())
  role        Role      @default(ENGINEER)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model Environment {
  id           String       @id @default(uuid())
  name         String
  slug         String
  isProduction Boolean      @default(false)
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services     Service[]
  deployments  Deployment[]
  createdAt    DateTime     @default(now())

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Service {
  id              String        @id @default(uuid())
  name            String
  slug            String
  description     String?
  status          ServiceStatus @default(HEALTHY)
  uptime          Float         @default(99.99)
  latency         Float         @default(120.0)
  requestsPerSec  Int           @default(1500)
  errorRate       Float         @default(0.05)
  cpuUsage        Float         @default(35.0)
  memoryUsage     Float         @default(55.0)
  lastDeploymentAt DateTime?
  workspaceId     String
  environmentId   String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment     Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  deployments     Deployment[]
  incidents       Incident[]
  metricPoints    MetricPoint[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([status])
}

model Deployment {
  id            String           @id @default(uuid())
  version       String
  commitSha     String
  commitMessage String
  branch        String           @default("main")
  authorName    String
  authorEmail   String
  status        DeploymentStatus @default(SUCCESSFUL)
  durationMs    Int              @default(45000)
  workspaceId   String
  serviceId     String
  environmentId String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  environment   Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  logs          DeploymentLog[]
  incidents     Incident[]       @relation("RelatedDeployment")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([workspaceId])
  @@index([serviceId])
  @@index([status])
  @@index([commitSha])
}

model DeploymentLog {
  id           String     @id @default(uuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  level        LogLevel   @default(INFO)
  message      String
  timestamp    DateTime   @default(now())

  @@index([deploymentId])
}

model Incident {
  id                  String           @id @default(uuid())
  title               String
  description         String
  severity            IncidentSeverity @default(MEDIUM)
  status              IncidentStatus   @default(INVESTIGATING)
  startedAt           DateTime         @default(now())
  resolvedAt          DateTime?
  durationMinutes     Int?
  workspaceId         String
  serviceId           String?
  assignedUserId      String?
  relatedDeploymentId String?
  aiRootCause         String?
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service             Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedUser        User?            @relation("AssignedIncidents", fields: [assignedUserId], references: [id], onDelete: SetNull)
  relatedDeployment   Deployment?      @relation("RelatedDeployment", fields: [relatedDeploymentId], references: [id], onDelete: SetNull)
  events              IncidentEvent[]
  aiAnalyses          AIAnalysis[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([severity])
  @@index([startedAt])
}

model IncidentEvent {
  id          String            @id @default(uuid())
  incidentId  String
  incident    Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        IncidentEventType @default(NOTE_ADDED)
  title       String
  description String
  authorName  String
  createdAt   DateTime          @default(now())

  @@index([incidentId])
}

model LogEntry {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceName String
  environment String    @default("production")
  level       LogLevel  @default(INFO)
  message     String
  requestId   String
  traceId     String
  metadata    Json?
  timestamp   DateTime  @default(now())

  @@index([workspaceId, timestamp])
  @@index([serviceName])
  @@index([level])
  @@index([traceId])
}

model MetricPoint {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  timestamp   DateTime  @default(now())
  requests    Int
  latency     Float
  errorRate   Float
  cpu         Float
  memory      Float

  @@index([workspaceId, timestamp])
  @@index([serviceId, timestamp])
}

model AIAnalysis {
  id                  String    @id @default(uuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incidentId          String?
  incident            Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  analysisType        String // ROOT_CAUSE, POSTMORTEM, LOG_SUMMARY, SLACK_COMMUNICATION
  prompt              String
  summary             String
  rootCause           String?
  confidenceScore     Float     @default(0.92)
  isDeterministic     Boolean   @default(false)
  structuredOutput    Json?
  createdAt           DateTime  @default(now())

  @@index([workspaceId])
  @@index([incidentId])
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String    @default("INFO") // INFO, WARNING, CRITICAL
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId])
}
